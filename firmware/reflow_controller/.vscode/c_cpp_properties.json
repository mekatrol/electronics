{
    "configurations": [
        {
            "name": "WSL ARM LPC1769",
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "compilerArgs": [
                "-mcpu=cortex-m3",
                "-mthumb",
                "-ffreestanding"
            ],
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/mainboard",
                "${workspaceFolder}/boards/mainboard/include",
                "${workspaceFolder}/boards/display"
            ],
            "defines": [
                "__LPC1769__",
                "BTT_SKR_1_4_TURBO"
            ],
            "cStandard": "c11",
            "intelliSenseMode": "linux-gcc-arm",
            "browse": {
                "path": [
                    "${workspaceFolder}/src",
                    "${workspaceFolder}/boards"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}

