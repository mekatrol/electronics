{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug KiCad Tools backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "kicad_tools_app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "serverReadyAction": {
        "pattern": "Uvicorn running on (http://[^ ]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Debug current pytest file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-vv",
        "${file}"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ]
}