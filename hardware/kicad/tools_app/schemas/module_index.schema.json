{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kicad-tools/module-index.schema.json",
  "title": "KiCad tools module index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "application_compatibility", "modules"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "application_compatibility": {"type": "string", "minLength": 1},
    "categories": {"type": "array", "items": {"$ref": "#/$defs/category"}},
    "modules": {"type": "array", "items": {"$ref": "#/$defs/module"}}
  },
  "$defs": {
    "category": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}
    },
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "module": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "description", "script", "enabled", "category", "execution_type", "requires_kicad", "requires_pcb_editor", "requires_kicad_api", "working_directory", "timeout_seconds", "parameters", "risk"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1},
        "script": {"type": "string", "pattern": "^\\.\\./modules/[A-Za-z0-9_]+\\.py$"}, "enabled": {"type": "boolean"}, "category": {"$ref": "#/$defs/id"},
        "execution_type": {"enum": ["read_only", "kicad_modify", "file_generate", "system_control"]},
        "requires_kicad": {"type": "boolean"}, "requires_pcb_editor": {"type": "boolean"}, "requires_kicad_api": {"type": "boolean"},
        "working_directory": {"enum": ["repository_root", "script_directory", "input_parent", "temporary_directory"]},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}}, "risk": {"$ref": "#/$defs/risk"}
      }
    },
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "label", "description", "kind", "type", "required", "default"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "label": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1},
        "kind": {"enum": ["positional", "option"]}, "flag": {"type": "string", "pattern": "^--[a-z][a-z0-9-]*$"},
        "type": {"enum": ["string", "integer", "number", "boolean", "enum", "file", "directory", "string_list"]},
        "required": {"type": "boolean"}, "default": {}, "minimum": {"type": "number"}, "maximum": {"type": "number"},
        "extensions": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9_+-]+$"}, "uniqueItems": true},
        "choices": {"type": "array", "minItems": 1, "uniqueItems": true}, "may_create": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "option"}}}, "then": {"required": ["flag"]}},
        {"if": {"properties": {"kind": {"const": "positional"}}}, "then": {"not": {"required": ["flag"]}}},
        {"if": {"properties": {"type": {"const": "enum"}}}, "then": {"required": ["choices"]}}
      ]
    },
    "risk": {
      "type": "object", "additionalProperties": false, "required": ["level", "summary", "confirmation_required"],
      "properties": {"level": {"enum": ["low", "medium", "high", "critical"]}, "summary": {"type": "string", "minLength": 1}, "confirmation_required": {"type": "boolean"}}
    }
  }
}
