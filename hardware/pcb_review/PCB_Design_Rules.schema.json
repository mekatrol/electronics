{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/pcb-review-catalog-1.0.schema.json",
  "title": "PCB review wizard catalog schema",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "guide_version",
    "workflow_stages",
    "sections",
    "sources",
    "checks"
  ],
  "properties": {
    "format": {
      "const": "pcb-design-review-catalog"
    },
    "schema_version": {
      "type": "string"
    },
    "guide_version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "workflow_stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "order"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stage_id",
          "title",
          "check_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "stage_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sources": {
      "type": "object"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stage_id",
          "section_id",
          "title",
          "intent",
          "why_it_matters",
          "how_to_check",
          "acceptance_criteria",
          "constraints_and_guidance",
          "evidence_to_record",
          "when_applicable",
          "conditional",
          "priority",
          "source_refs",
          "review_fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(SCH|PCB|EXT|REL)-[0-9]{3}$"
          },
          "stage_id": {
            "enum": [
              "SCH",
              "PCB",
              "EXT",
              "REL"
            ]
          },
          "section_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source_prompt": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "how_to_check": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "constraints_and_guidance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_to_record": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "when_applicable": {
            "type": "string"
          },
          "conditional": {
            "type": "boolean"
          },
          "priority": {
            "enum": [
              "critical",
              "high",
              "standard"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source_id"
              ],
              "properties": {
                "source_id": {
                  "type": "string"
                }
              }
            }
          },
          "review_fields": {
            "type": "object"
          }
        }
      }
    }
  }
}